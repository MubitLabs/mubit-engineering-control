{
  "name": "@mec/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.js && node ../../scripts/bundle.mjs src/migrate-cli.ts dist/migrate.js",
    "dev": "tsx watch src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "@mec/contracts": "workspace:*",
    "@mec/domain": "workspace:*",
    "@mec/policy": "workspace:*",
    "fastify": "5.12.7",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  }
}
