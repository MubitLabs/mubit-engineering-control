{
  "name": "mec",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:desktop": "node scripts/bundle-desktop.mjs",
    "pack:internal": "node scripts/pack-tarball.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:a": "vitest run --project a",
    "test:b": "vitest run --project b",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  },
  "version": "0.3.2"
}
