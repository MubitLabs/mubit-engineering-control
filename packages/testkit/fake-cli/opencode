#!/usr/bin/env node
/**
 * A stand-in for the `opencode` binary that really runs as a process. `serve --stdio` speaks the
 * 2.2.5 shapes: one `{"url"}` line on stdout, HTTP Basic user `opencode`, the SSE stream, a stdin
 * EOF that shuts it down, and a stream that goes on talking after the verdict. It reads the
 * config file it is pointed at and calls the same mec-tools endpoint a real engine does.
 *
 * A test copies this file into its own directory and writes `scenario.json` beside it. Fields:
 *
 *   version: 'opencode v2.2.5'     what `--version` prints
 *   noUrl: true                    serve prints garbage instead of the url line
 *   replyFails: 500                a permission reply answers this status
 *   steps: [...]                   what a prompt does, each one of:
 *
 *   {event: {type, data}}          one SSE event
 *   {write: {path, text}}          write a file relative to the session directory
 *   {ask: {id, action, resources, source?}}  permission.asked; the reply lands in answers.jsonl
 *   {asks: [ask, ...]}             parallel asks. Like the real server, a reject settles every
 *                                  other ask still pending, whose own reply then answers 404
 *   {call: {tool, args}}           a mec-tools call; the answer lands in tool-answers.jsonl
 *   {saveToken: true}              copy the bearer token to token.txt beside this file
 *   {sleep: ms}                    wait
 *   {hold: 'name'}                 wait until a file of this name appears beside this file
 *   {verdict: 'succeeded'}         session.execution.<verdict>, then a late usage event
 *
 * It writes `seen.json` beside itself on serve start, and appends each request to
 * `requests.jsonl`.
 */
import { appendFileSync, existsSync, readFileSync, realpathSync, writeFileSync } from 'node:fs'
import { createServer } from 'node:http'
import { dirname, join } from 'node:path'

const here = dirname(realpathSync(process.argv[1]))
const scenario = JSON.parse(readFileSync(join(here, 'scenario.json'), 'utf8'))
const argv = process.argv.slice(2)

if (argv[0] === '--version') {
  console.log(scenario.version ?? 'opencode v2.2.5')
  process.exit(0)
}
if (argv[0] !== 'serve') process.exit(64)

const config = process.env.OPENCODE_CONFIG
const parsed = config === undefined ? {} : JSON.parse(readFileSync(config, 'utf8'))
const mec = parsed.mcp?.servers?.mec
const expand = (text) => text.replace(/\{env:([A-Z_]+)\}/g, (_, name) => process.env[name] ?? '')
const authorization = mec === undefined ? undefined : expand(mec.headers.Authorization)

writeFileSync(
  join(here, 'seen.json'),
  `${JSON.stringify({
    argv,
    cwd: process.cwd(),
    pid: process.pid,
    path0: (process.env.PATH ?? '').split(':')[0],
    attempt: process.env.MEC_ATTEMPT_ID ?? null,
    project_config_off: process.env.OPENCODE_DISABLE_PROJECT_CONFIG ?? null,
    xdg_config_home: process.env.XDG_CONFIG_HOME ?? null,
    xdg_data_home: process.env.XDG_DATA_HOME ?? null,
    opencode_config_dir: process.env.OPENCODE_CONFIG_DIR ?? null,
    config_path: config ?? null,
    config: parsed,
    self: process.argv[1],
    env_names: Object.keys(process.env),
  })}\n`,
)

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms))
const expected = `Basic ${Buffer.from(`opencode:${process.env.OPENCODE_PASSWORD}`).toString('base64')}`
const streams = new Set()
const replies = new Map()
const SESSION = 'ses_fake_1'
let directory = process.cwd()

const event = (type, data) => {
  const line = `data: ${JSON.stringify({ id: 'evt', created: 0, type, location: {}, data })}\n\n`
  for (const stream of streams) stream.write(line)
}

async function call(tool, args) {
  const response = await fetch(mec.url, {
    method: 'POST',
    headers: { 'content-type': 'application/json', authorization },
    body: JSON.stringify({
      jsonrpc: '2.0',
      id: 1,
      method: 'tools/call',
      params: { name: tool, arguments: args },
    }),
  })
  appendFileSync(join(here, 'tool-answers.jsonl'), `${JSON.stringify({ tool, answer: await response.json() })}\n`)
}

async function ask(request) {
  const reply = new Promise((resolve) => replies.set(request.id, resolve))
  event('permission.asked', { sessionID: SESSION, source: { type: 'tool', id: 'x' }, ...request })
  appendFileSync(join(here, 'answers.jsonl'), `${JSON.stringify({ id: request.id, answer: await reply })}\n`)
}

async function turn() {
  for (const step of scenario.steps ?? []) {
    if (step.event !== undefined) event(step.event.type, step.event.data)
    else if (step.write !== undefined) writeFileSync(join(directory, step.write.path), step.write.text)
    else if (step.ask !== undefined) await ask(step.ask)
    else if (step.asks !== undefined) await Promise.all(step.asks.map(ask))
    else if (step.call !== undefined) await call(step.call.tool, step.call.args ?? {})
    else if (step.saveToken === true) {
      writeFileSync(join(here, 'token.txt'), (authorization ?? '').replace(/^Bearer /, ''))
    } else if (step.sleep !== undefined) await sleep(step.sleep)
    else if (step.hold !== undefined) {
      while (!existsSync(join(here, step.hold))) await sleep(25)
    } else if (step.verdict !== undefined) {
      event(`session.execution.${step.verdict}`, { sessionID: SESSION })
      await sleep(100) // a later chunk: in the same one, a stream cut at the verdict would still show it
      event('session.renamed', { sessionID: SESSION, title: 'after the verdict' })
    }
  }
}

const server = createServer((request, response) => {
  if (request.headers.authorization !== expected) {
    response.writeHead(401).end()
    return
  }
  let text = ''
  request.setEncoding('utf8')
  request.on('data', (chunk) => {
    text += chunk
  })
  request.on('end', () => {
    const body = text === '' ? undefined : JSON.parse(text)
    const path = request.url ?? ''
    appendFileSync(join(here, 'requests.jsonl'), `${JSON.stringify({ method: request.method, path, body })}\n`)
    if (path === '/api/event') {
      response.writeHead(200, { 'content-type': 'text/event-stream' })
      streams.add(response)
      response.write('data: {"id":"e0","created":0,"type":"server.connected","data":{}}\n\n')
      return
    }
    if (path === '/api/session') {
      directory = body?.location?.directory ?? directory
      response.writeHead(200, { 'content-type': 'application/json' })
      response.end(JSON.stringify({ data: { id: SESSION } }))
      event('session.created', { sessionID: SESSION, model: body?.model ?? {} })
      return
    }
    if (path.endsWith('/prompt')) {
      response.writeHead(200, { 'content-type': 'application/json' })
      response.end('{}')
      void turn()
      return
    }
    const reply = path.match(/\/permission\/([^/]+)\/reply$/)
    if (reply !== null) {
      if (scenario.replyFails !== undefined) {
        response.writeHead(scenario.replyFails).end('{"name":"UnknownError"}')
        return
      }
      const settled = replies.get(reply[1])
      if (settled === undefined) {
        response.writeHead(404, { 'content-type': 'application/json' })
        response.end('{"name":"PermissionNotFoundError"}')
        return
      }
      response.writeHead(204).end()
      replies.delete(reply[1])
      settled(body)
      if (body?.decision === 'reject') {
        for (const dropped of replies.values()) dropped({ dropped: true })
        replies.clear()
      }
      return
    }
    response.writeHead(200, { 'content-type': 'application/json' })
    response.end('{}')
  })
})

server.listen(0, '127.0.0.1', () => {
  const { port } = server.address()
  process.stdout.write(
    scenario.noUrl === true ? 'not a url\n' : `${JSON.stringify({ url: `http://127.0.0.1:${port}` })}\n`,
  )
})
setInterval(() => {
  for (const stream of streams) stream.write(': heartbeat\n\n')
}, 200)
// `serve --stdio`: stdin EOF is the shutdown.
process.stdin.resume()
process.stdin.on('end', () => process.exit(0))
